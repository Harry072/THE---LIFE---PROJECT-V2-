SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_KEY is also supported for local compatibility, but service role keys must stay server-only.
# SUPABASE_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY is also supported by google-genai and takes precedence if both are set.
# GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your-groq-api-key
GROQ_COMPANION_MODEL=llama-3.1-8b-instant
GROQ_COMPANION_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_COMPANION_FALLBACK_MODEL=llama-3.1-8b-instant
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
